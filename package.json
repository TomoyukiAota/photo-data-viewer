{
  "name": "photo-data-viewer",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "dev:plm": "cross-env PDV_IN_PLM=True next dev --webpack -p 3100",
    "build": "next build --webpack",
    "start": "next start",
    "format": "prettier --write --ignore-path .gitignore ./**/*.{js,jsx,ts,tsx,css,scss}",
    "lint": "eslint src types next.config.js jest.config.js playwright.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:all": "npm run lint && npm run typecheck && npm test -- --runInBand",
    "check": "npm outdated --long",
    "build:plm": "cross-env PDV_IN_PLM=True next build --webpack",
    "start:plm": "cross-env PDV_IN_PLM=True next start -p 3100",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:electron": "playwright test -c playwright.electron.config.mjs"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@react-hook/debounce": "4.0.0",
    "@react-hook/size": "2.1.2",
    "@react-hook/window-size": "3.1.1",
    "@rehooks/local-storage": "2.4.5",
    "classnames": "2.5.1",
    "dayjs": "1.11.23",
    "exifr": "7.1.3",
    "filesize": "11.0.29",
    "get-file-object-from-local-path": "1.0.2",
    "is-number": "7.0.0",
    "leaflet": "1.9.4",
    "leaflet-defaulticon-compatibility": "0.1.2",
    "libheif-js": "1.23.5",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-leaflet": "5.0.0",
    "react-reflex": "6.0.2",
    "sort-keys": "6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@svgr/webpack": "8.1.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/gtag.js": "0.0.20",
    "@types/is-number": "7.0.5",
    "@types/jest": "30.0.0",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "prettier": "3.9.10",
    "sass": "1.107.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "packageManager": "npm@12.2.1",
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true
  }
}
